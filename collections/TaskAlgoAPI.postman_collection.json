{
  "info": {
    "name": "Task & Team Management Platform API",
    "description": "Complete API collection for the Task & Team Management Platform.\n\nBase URL: https://task-and-team-management-platform.onrender.com\n\nTest Accounts:\n- testuser@example.com / Test@1234 (user)\n- admin@example.com / Admin@1234 (admin)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://task-and-team-management-platform.onrender.com"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health Check",
      "item": [
        {
          "name": "GET /api/health",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/health",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has success field', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.success).to.be.true;",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Authentication",
      "item": [
        {
          "name": "POST /api/auth/register",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201 or 400 (duplicate)', () => {",
                  "  pm.expect(pm.response.code).to.be.oneOf([201, 400]);",
                  "});",
                  "if (pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.environment.set('token', json.data.token);",
                  "  pm.environment.set('userId', json.data.user.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (User)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.data.token);",
                  "pm.environment.set('userId', json.data.user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/login (Admin)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"Admin@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.environment.set('token', json.data.token);",
                  "pm.environment.set('userId', json.data.user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Response has user', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.user).to.exist;",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/login (Remember Me)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\",\n  \"rememberMe\": true\n}"
            }
          }
        },
        {
          "name": "POST /api/auth/login (Invalid Credentials)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"WrongPassword\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error message returned', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.equal('Invalid email or password');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/auth/register (Duplicate Email)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Test User\",\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Test@1234\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Duplicate user error', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.error).to.equal('User already exists');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Tasks",
      "item": [
        {
          "name": "GET /api/tasks (List All)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?page=1&limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "limit", "value": "10" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Returns paginated tasks', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.tasks).to.be.an('array');",
                  "  pm.expect(json.data.page).to.be.a('number');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tasks (With Search)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?search=design",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "search", "value": "design" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "GET /api/tasks (Filter by Status)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?status=pending",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "status", "value": "pending" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "GET /api/tasks (Filter by Priority)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?priority=high",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "priority", "value": "high" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "GET /api/tasks (Sort by Due Date)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/tasks?sort=dueDate",
              "host": ["{{baseUrl}}"],
              "path": ["api", "tasks"],
              "query": [
                { "key": "sort", "value": "dueDate" }
              ]
            },
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "GET /api/tasks/:id (Get Single)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "POST /api/tasks (Create)",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"New task from API\",\n  \"description\": \"This task was created via Postman\",\n  \"priority\": \"medium\",\n  \"dueDate\": \"2026-10-01\",\n  \"status\": \"pending\",\n  \"assignedTo\": \"{{userId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.environment.set('taskId', json.data.task._id);"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /api/tasks/:id (Update)",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated task title\",\n  \"status\": \"in-progress\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Title updated', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.task.title).to.equal('Updated task title');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /api/tasks/:id/duplicate",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}/duplicate",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Copy suffix added', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.task.title).to.include('(Copy)');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /api/tasks/:id",
          "request": {
            "method": "DELETE",
            "url": "{{baseUrl}}/api/tasks/{{taskId}}",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tasks (Unauthorized)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks",
            "header": []
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 401', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/tasks/invalid-id (Invalid ID)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/tasks/invalid-id",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 400 or 500', () => pm.expect(pm.response.code).to.be.oneOf([400, 500]));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Users (Admin)",
      "item": [
        {
          "name": "GET /api/users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "GET /api/admin/stats",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/stats",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Has stats', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data).to.have.property('totalUsers');",
                  "  pm.expect(json.data).to.have.property('totalTasks');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /api/admin/users",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/users",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        },
        {
          "name": "GET /api/admin/tasks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/admin/tasks",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ]
          }
        }
      ]
    },
    {
      "name": "File Upload",
      "item": [
        {
          "name": "POST /api/upload",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/upload",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": ""
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns file URL', () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json.data.file.url).to.be.a('string');",
                  "  pm.expect(json.data.file.name).to.be.a('string');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
